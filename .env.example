# Copiar como .env y completar solo en el computador/servidor de instalación.
# Nunca subir .env a GitHub.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=clinica_app
DB_PASSWORD=
DB_NAME=clinica

# Correo: usar credenciales aprobadas por TI.
# SMTP_HOST vacío usa Gmail. Con servidor propio: puerto 587 + false, o 465 + true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Producción: HTTPS servido por un proxy configurado por TI.
PUBLIC_ORIGIN=
# Solo configurar si el acceso al backend está limitado al proxy confiable.
TRUST_PROXY_HOPS=
# Rutas absolutas privadas y persistentes, fuera del repositorio.
CLINICA_DATA_DIR=
CLINICA_BACKUP_DIR=
MYSQLDUMP_PATH=

# Integraciones opcionales. Dejarlas vacías hasta configurar los servicios reales.
IMER_WEBHOOK_TOKEN=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
LDAP_URL=
LDAP_BIND_DN=
LDAP_PASSWORD=
LDAP_BASE_DN=
LDAP_FILTER=(&(objectClass=person)(mail=*))
LDAP_CHANGE_ATTRIBUTE=whenChanged
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v23.0
